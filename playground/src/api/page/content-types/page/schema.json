{
	"kind": "collectionType",
	"collectionName": "pages",
	"info": {
		"singularName": "page",
		"pluralName": "pages",
		"displayName": "Page",
		"description": "Localized collection type (en, nl) for testing scheduled (un)publishing per locale"
	},
	"options": {
		"draftAndPublish": true
	},
	"pluginOptions": {
		"i18n": {
			"localized": true
		}
	},
	"attributes": {
		"title": {
			"type": "string",
			"required": true,
			"pluginOptions": { "i18n": { "localized": true } }
		},
		"slug": {
			"type": "uid",
			"targetField": "title",
			"pluginOptions": { "i18n": { "localized": true } }
		},
		"seo": {
			"type": "component",
			"component": "shared.seo",
			"repeatable": false,
			"required": true,
			"pluginOptions": { "i18n": { "localized": true } }
		},
		"sections": {
			"type": "dynamiczone",
			"components": [
				"blocks.hero",
				"blocks.rich-text",
				"blocks.quote",
				"blocks.media",
				"blocks.call-to-action"
			],
			"pluginOptions": { "i18n": { "localized": true } }
		},
		"faq": {
			"type": "component",
			"component": "blocks.faq-item",
			"repeatable": true,
			"pluginOptions": { "i18n": { "localized": true } }
		},
		"showInNavigation": {
			"type": "boolean",
			"default": true,
			"pluginOptions": { "i18n": { "localized": false } }
		}
	}
}
