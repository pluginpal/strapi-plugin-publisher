{
	"kind": "singleType",
	"collectionName": "homepages",
	"info": {
		"singularName": "homepage",
		"pluralName": "homepages",
		"displayName": "Homepage",
		"description": "Single type for testing scheduled (un)publishing, with components and a dynamic zone"
	},
	"options": {
		"draftAndPublish": true
	},
	"pluginOptions": {},
	"attributes": {
		"title": {
			"type": "string",
			"required": true
		},
		"intro": {
			"type": "text"
		},
		"hero": {
			"type": "component",
			"component": "blocks.hero",
			"repeatable": false,
			"required": true
		},
		"sections": {
			"type": "dynamiczone",
			"components": ["blocks.rich-text", "blocks.quote", "blocks.media", "blocks.call-to-action"]
		},
		"seo": {
			"type": "component",
			"component": "shared.seo",
			"repeatable": false
		}
	}
}
