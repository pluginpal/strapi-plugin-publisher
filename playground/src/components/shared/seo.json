{
	"collectionName": "components_shared_seos",
	"info": {
		"displayName": "SEO",
		"description": "Meta data for search engines and social sharing",
		"icon": "search"
	},
	"options": {},
	"attributes": {
		"metaTitle": {
			"type": "string",
			"required": true,
			"maxLength": 70
		},
		"metaDescription": {
			"type": "text",
			"maxLength": 160
		},
		"shareImage": {
			"type": "media",
			"multiple": false,
			"allowedTypes": ["images"]
		},
		"noIndex": {
			"type": "boolean",
			"default": false
		}
	}
}
